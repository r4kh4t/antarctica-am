# Copy to .env.local and fill in your values.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# Optional: Langfuse LLM observability — leave blank to disable tracing.
# Get your keys at https://cloud.langfuse.com → Settings → API Keys
# EU cloud: https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Rollbar error tracking — leave blank to disable.
# Quickest setup: Vercel dashboard → Integrations → Rollbar (auto-provisions tokens).
# Manual: https://rollbar.com → create project → Project Access Tokens.
NEXT_PUBLIC_ROLLBAR_CLIENT_TOKEN=...   # post_client_item scope
ROLLBAR_SERVER_TOKEN=...               # post_server_item scope
