#!/bin/sh
# Enforce Conventional Commits format:
#   <type>(<scope>): <description>
#
# Valid types: feat fix docs style refactor test chore ci perf build revert
# Scope is optional. Description must be 1–100 characters.
#
# Good:  feat(llm): add Langfuse tracing
# Good:  fix: handle missing rationale gracefully
# Bad:   WIP: stuff
# Bad:   updated things

commit_msg=$(cat "$1")

# Allow merge commits, fixup commits, and revert commits generated by git itself
if echo "$commit_msg" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\([a-z0-9/_-]+\))?: .{1,100}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "  ✗ Commit message format error"
  echo ""
  echo "  Required format:  <type>(<scope>): <description>"
  echo "  Example:          feat(llm): add Langfuse tracing"
  echo ""
  echo "  Valid types: feat  fix  docs  style  refactor  test  chore  ci  perf  build  revert"
  echo "  Scope is optional. Description must be 1–100 characters."
  echo ""
  echo "  Your message: $commit_msg"
  echo ""
  exit 1
fi
