#!/bin/sh
# Enforce Conventional Commits format:
#   <type>(<scope>): <description> (#N)
#
# Valid types: feat fix docs style refactor test chore ci perf build revert
# Scope is optional. Description must be 1–100 characters.
# GitHub issue reference is recommended for feat/fix/refactor commits: (#N)
#
# Good:  feat(llm): add Langfuse tracing (#4)
# Good:  fix: handle missing rationale gracefully (#12)
# Good:  chore: update lockfile          ← no issue ref needed for chore/style/ci
# Bad:   WIP: stuff
# Bad:   updated things

commit_msg=$(cat "$1")

# Allow merge commits, fixup commits, and revert commits generated by git itself
if echo "$commit_msg" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\([a-z0-9/_-]+\))?: .{1,100}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "  ✗ Commit message format error"
  echo ""
  echo "  Required format:  <type>(<scope>): <description>"
  echo "  Example:          feat(llm): add Langfuse tracing (#4)"
  echo ""
  echo "  Valid types: feat  fix  docs  style  refactor  test  chore  ci  perf  build  revert"
  echo "  Scope is optional. Description must be 1–100 characters."
  echo ""
  echo "  Your message: $commit_msg"
  echo ""
  exit 1
fi

# Advisory: recommend a GitHub issue reference for feat/fix/refactor commits
first_line=$(echo "$commit_msg" | head -1)
type=$(echo "$first_line" | sed 's/(\([^)]*\)):.*//' | sed 's/:.*//')
if echo "$type" | grep -qE '^(feat|fix|refactor)$'; then
  if ! echo "$first_line" | grep -qE '#[0-9]+'; then
    echo ""
    echo "  ⚠  Tip: link a GitHub issue for traceability."
    echo "     e.g.  $first_line (#14)"
    echo "     Create one at: https://github.com/r4kh4t/antarctica-am-draft/issues/new"
    echo ""
  fi
fi
