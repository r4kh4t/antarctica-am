{
  "name": "antarctica-portfolio-recommendation",
  "author": "Rakhat Shakimbekov <rahateamfor@gmail.com>",
  "version": "1.12.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:big": "NODE_OPTIONS=--max-old-space-size=16384 next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "precommit": "lint-staged && npm run lint && npm test",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,json,css}": "biome format --write"
  },
  "dependencies": {
    "@instructor-ai/instructor": "^1.7.0",
    "@langfuse/openai": "^5.9.0",
    "@langfuse/otel": "^5.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@rollbar/react": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "langfuse": "^3.38.20",
    "next": "^16.2.9",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.9.0",
    "rollbar": "^3.1.0"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
